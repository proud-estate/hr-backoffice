rules_version = '2';

// กฎความปลอดภัยของฐานข้อมูลระบบ HR: คัดลอกไฟล์นี้ทั้งหมดไปวางที่ Firebase Console > Firestore Database > Rules แล้วกด Publish
// - ผู้ดูแลระบบ (owner): เห็นและแก้ไขได้ทุกอย่าง สร้างและปิดบัญชี HR ได้ ลบบริษัทได้
// - เจ้าหน้าที่ HR (hr): เพิ่มบริษัท กรอกพนักงาน การลา เงินเดือน และพิมพ์สลิปได้ แต่ลบบริษัทและจัดการบัญชีไม่ได้
// - ใบรับรองแพทย์ที่แนบ: เฉพาะบัญชี HR เท่านั้นที่เปิดดูได้
// - คนที่ไม่มีบัญชี: ไม่เห็นข้อมูลใดๆ เลย
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roleDoc() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function role() { return signedIn() && exists(roleDoc()) ? get(roleDoc()).data.role : ''; }
    function isOwner() { return role() == 'owner'; }
    function isHR() { return role() == 'hr' || role() == 'owner'; }

    // owner marker: anyone may check whether the system has been set up; it can be created once, never changed
    match /meta/owner {
      allow get: if true;
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/meta/owner)
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // who is owner / hr
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // the first owner creates their own role in the same batch as meta/owner; afterwards only an owner adds accounts
      allow create: if (isOwner() && request.resource.data.role in ['hr', 'owner'])
                    || (signedIn() && uid == request.auth.uid
                        && request.resource.data.role == 'owner'
                        && getAfter(/databases/$(database)/documents/meta/owner).data.uid == uid);
      // an owner cannot close or change their own account (prevents locking everyone out)
      allow update, delete: if isOwner() && uid != request.auth.uid;
    }

    // one document per company: settings, employees, holidays, leave records, payroll extras
    match /companies/{id} {
      allow read, create, update: if isHR();
      allow delete: if isOwner();
    }

    // scanned medical certificates (compressed image or small PDF), readable only by HR accounts
    match /files/{id} {
      allow read, delete: if isHR();
      allow create: if isHR() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update: if false;
    }
  }
}
